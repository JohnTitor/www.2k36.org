---
import { getEntry, render } from "astro:content";
import Markdown from "@components/misc/Markdown.astro";
import MainGridLayout from "../../layouts/MainGridLayout.astro";

const apiDoc = await getEntry("spec", "api");

if (!apiDoc) {
	throw new Error("API documentation not found");
}

const { Content, headings } = await render(apiDoc);
---

<MainGridLayout title="RSS API" description="RSS フィードの取得方法と稼働確認" headings={headings}>
	<div class="card-base px-9 py-6">
		<Markdown class="mt-2">
			<Content />
		</Markdown>
	</div>
</MainGridLayout>
