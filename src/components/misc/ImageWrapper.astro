---
import path from "node:path";
import type { ImageMetadata } from "astro";

interface Props {
	id?: string;
	src: string;
	class?: string;
	alt?: string;
	position?: string;
	basePath?: string;
	width?: number;
	widths?: number[];
	sizes?: string;
	loading?: "lazy" | "eager";
}

import { Image } from "astro:assets";
import { url } from "../../utils/url-utils";

const {
	id, src, alt, position = "center", basePath = "/",
	width = 960, widths = [480, 960, 1600],
	sizes = "(min-width: 1200px) 800px, (min-width: 1024px) calc(100vw - 400px), calc(100vw - 48px)",
	loading = "lazy",
} = Astro.props;
const className = Astro.props.class;

const isLocal = !(
	src.startsWith("/") ||
	src.startsWith("http") ||
	src.startsWith("https") ||
	src.startsWith("data:")
);
const isPublic = src.startsWith("/");

let img: ImageMetadata | undefined;
if (isLocal) {
	const files = import.meta.glob<ImageMetadata>([
		"../../content/posts/**/*.{png,jpg,jpeg,webp,avif,gif,svg}",
		"../../assets/images/**/*.{png,jpg,jpeg,webp,avif,gif,svg}",
	], {
		import: "default",
	});
	let normalizedPath = path
		.normalize(path.join("../../", basePath, src))
		.replace(/\\/g, "/");
	const file = files[normalizedPath];
	if (!file) {
		throw new Error(`Image file not found: ${normalizedPath.replace("../../", "src/")}`);
	} else {
		img = await file();
	}
}

const imageClass = "w-full h-full object-cover";
const imageStyle = [
	"display: block",
	"width: 100%",
	"height: 100%",
	"object-fit: cover",
	`object-position: ${position}`,
].join("; ");
const wrapperStyle = [
	"display: block",
	"width: 100%",
	"max-width: 100%",
	img?.width && img?.height ? `aspect-ratio: ${img.width} / ${img.height}` : "",
].filter(Boolean).join("; ");
---
<div
	id={id}
	data-image-wrapper
	class:list={[className, "overflow-hidden relative"]}
	style={wrapperStyle}
>
    <div class="transition absolute inset-0 dark:bg-black/10 bg-opacity-50 pointer-events-none"></div>
    {isLocal && img && <Image src={img} width={Math.min(width, img.width)} widths={widths} sizes={sizes} loading={loading} alt={alt || ""} class={imageClass} style={imageStyle}/>}
    {!isLocal && <img src={isPublic ? url(src) : src} loading={loading} decoding="async" alt={alt || ""} class={imageClass} style={imageStyle}/>}
</div>
