---
import { giscusConfig } from "@/config";
---

<div id="giscus_container">
  <template id="giscus-template">
  <script is:inline data-src="https://giscus.app/client.js"
    data-repo={giscusConfig.repo}
    data-repo-id={giscusConfig.repoId}
    data-category={giscusConfig.category}
    data-category-id={giscusConfig.categoryId}
    data-mapping={giscusConfig.mapping}
    data-strict="0"
    data-reactions-enabled={giscusConfig.reactionsEnabled ? "1" : "0"}
    data-emit-metadata="0"
    data-input-position={giscusConfig.inputPosition}
    data-theme={giscusConfig.theme}
    data-lang={giscusConfig.lang}
    data-loading="lazy"
    crossorigin="anonymous"
    async>
  </script>
  </template>
</div>

<script>
	const container = document.getElementById("giscus_container")!;
	const observer = new IntersectionObserver((entries) => {
		if (!entries.some((entry) => entry.isIntersecting)) return;
		observer.disconnect();
		const template = document.getElementById("giscus-template") as HTMLTemplateElement;
		const source = template.content.querySelector("script")!;
		const script = document.createElement("script");
		for (const attribute of source.attributes) script.setAttribute(attribute.name, attribute.value);
		script.src = source.dataset.src!;
		container.append(script);
	}, { rootMargin: "300px" });
	observer.observe(container);
</script>
